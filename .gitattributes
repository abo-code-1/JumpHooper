# Normalize text files to LF in the repo.
* text=auto eol=lf

# Windows batch files need CRLF; the Unix wrapper must stay LF.
*.bat   text eol=crlf
gradlew text eol=lf

# Binary assets — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ttf  binary
*.otf  binary
*.mp3  binary
*.jar  binary
